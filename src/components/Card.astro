---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";
import Tag from "./Tag.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, tags, ...props } = data;
---

<li class="py-6">
  <ul class="mb-2 flex flex-wrap gap-1.5">
    {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
  </ul>
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class="group block focus-visible:no-underline"
  >
    <Heading
      transition:name={toTransitionName(id)}
      class="group-hover:text-accent text-xl leading-snug font-bold transition-colors"
    >
      {title}
    </Heading>
    <p
      class="text-muted-foreground mt-2 line-clamp-2 max-w-2xl leading-relaxed"
    >
      {description}
    </p>
  </a>
  <Datetime {...props} class="mt-3" />
</li>
